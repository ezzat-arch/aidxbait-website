NEXT_PUBLIC_SITE_URL=NEXT_PUBLIC_SITE_URL

# Supabase
NEXT_PUBLIC_SUPABASE_URL=NEXT_PUBLIC_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=SUPABASE_SERVICE_ROLE_KEY

# Paymob
PAYMOB_API_KEY=PAYMOB_API_KEY
PAYMOB_INTEGRATION_ID=PAYMOB_INTEGRATION_ID
PAYMOB_IFRAME_ID=PAYMOB_IFRAME_ID
PAYMOB_PUBLIC_KEY=PAYMOB_PUBLIC_KEY
PAYMOB_SECRET_KEY=PAYMOB_SECRET_KEY
PAYMOB_HMAC_SECRET=PAYMOB_HMAC_SECRET

# Shopify (Storefront API; the token is public by design)
# This MUST be the permanent `{shop}.myshopify.com` domain, never the custom
# checkout domain, even after that becomes the store's primary domain: the order
# webhook compares `X-Shopify-Shop-Domain` against it, and Shopify only ever
# sends the myshopify one there. Get it from Shopify admin > Settings > Domains.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN
# Optional. Custom checkout domain from Shopify admin > Settings > Domains
# (e.g. shop.doctoory.com). Checkout links are rewritten to it, so set it only
# once that domain is live, or every checkout link points at a dead host.
SHOPIFY_CHECKOUT_DOMAIN=
# Shop-level webhook signing secret, from Shopify admin > Settings >
# Notifications > Webhooks (shown under the list of webhooks). Server only.
# Without it every delivery to /api/shopify/webhooks/orders/ is refused with a
# 401, so store orders never reach My Orders.
SHOPIFY_WEBHOOK_SECRET=
